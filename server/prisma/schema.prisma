// Plain JavaScript client, so Vercel can bundle it without TypeScript support
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  fr
  en
}

enum TransactionType {
  EXPENSE
  INCOME
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String
  // Hash of the recovery code shown once to the user; empty for accounts created before it existed
  recoveryCodeHash  String?
  language          Language @default(fr)
  // Reminder time is local to the user's time zone (HH:MM)
  timezone          String   @default("Europe/Paris")
  reminderOn        Boolean  @default(true)
  reminderTime      String   @default("21:00")
  // ISO weekdays: 1 = Monday ... 7 = Sunday
  reminderDays      Int[]    @default([1, 2, 3, 4, 5, 6, 7])
  alertsOn          Boolean  @default(true)
  // Sessions issued before this date are rejected (set on password change)
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())

  transactions      Transaction[]
  recurrences       Recurrence[]
  budgets           Budget[]
  pushSubscriptions PushSubscription[]
  dayChecks         DayCheck[]
}

// Fixed list seeded by the site; the id is also the translation key
model Category {
  id           String          @id
  type         TransactionType
  icon         String
  color        String
  sortOrder    Int
  requiresNote Boolean         @default(false)

  transactions Transaction[]
  recurrences  Recurrence[]
  budgets      Budget[]
}

model Transaction {
  id           String          @id @default(uuid())
  // Money is stored in cents to avoid floating point errors
  amountCents  Int
  type         TransactionType
  date         DateTime        @db.Date
  note         String?
  categoryId   String
  userId       String
  recurrenceId String?
  createdAt    DateTime        @default(now())

  category   Category    @relation(fields: [categoryId], references: [id])
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

enum Frequency {
  MONTHLY
  YEARLY
}

model Recurrence {
  id               String          @id @default(uuid())
  label            String
  amountCents      Int
  type             TransactionType
  frequency        Frequency
  // Next debit (or first debit after a free trial); moved forward each time it is added
  nextDate         DateTime        @db.Date
  // Day of the month to come back to after short months (31 -> 28 -> 31)
  anchorDay        Int
  // Set while the subscription is a free trial ending on nextDate
  trialUntil       DateTime?       @db.Date
  remindOn         Boolean         @default(false)
  remindDaysBefore Int             @default(3)
  // Debit date already reminded, so a reminder is sent only once
  remindedFor      DateTime?       @db.Date
  categoryId       String
  userId           String
  createdAt        DateTime        @default(now())

  category     Category      @relation(fields: [categoryId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Budget {
  id          String  @id @default(uuid())
  // Month as "YYYY-MM"
  month       String
  amountCents Int
  // Empty category = global budget for the month
  categoryId  String?
  userId      String

  category Category?     @relation(fields: [categoryId], references: [id])
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts   BudgetAlert[]

  @@index([userId, month])
}

model BudgetAlert {
  id        String   @id @default(uuid())
  // 80 or 100 (percent of the budget)
  threshold Int
  // Month the alert is about, "YYYY-MM": a budget reused over several months alerts once per month
  month     String
  budgetId  String
  sentAt    DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, month, threshold])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A day the user confirmed with "Nothing spent today"
model DayCheck {
  id     String   @id @default(uuid())
  date   DateTime @db.Date
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
