PORT=4000
DATABASE_URL="postgresql://ecobud:CHANGE_ME@localhost:5432/ecobud"
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME"
# Notification keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="CHANGE_ME"
VAPID_PRIVATE_KEY="CHANGE_ME"
VAPID_SUBJECT="https://github.com/mrtmathis/ecobud"
# Key the cron-job.org task sends to run the notification job (at least 32 characters)
JOBS_SECRET="CHANGE_ME"
# Open banking (optional, read only) with Enable Banking: https://enablebanking.com/docs/
# Application id from the Enable Banking control panel
ENABLE_BANKING_APP_ID="CHANGE_ME"
# Private key of that application: a file in server/secrets/ (never committed) in development,
# or the whole .pem file encoded in base64 in ENABLE_BANKING_PRIVATE_KEY on Vercel
ENABLE_BANKING_KEY_FILE="secrets/enablebanking-sandbox.pem"
# ENABLE_BANKING_PRIVATE_KEY="CHANGE_ME"
# Encrypts the bank connection ids in the database: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_ENCRYPTION_KEY="CHANGE_ME"
# Where the bank sends the user back; must be listed in the Enable Banking application
BANK_REDIRECT_URL="http://localhost:5173/api/bank/callback"
# Accounts allowed to link a bank (comma separated e-mails); without a contract, only the developer's own
BANK_ALLOWED_EMAILS=""
